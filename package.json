{
  "name": "qronos-cli-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marketing site and documentation for Qronos CLI",
  "scripts": {
    "dev": "vite",
    "build": "npm run docs:index && tsc --noEmit && npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "node scripts/serve-static.mjs dist 4173",
    "lint": "tsc --noEmit",
    "test": "npm run docs:index && vitest run",
    "docs:index": "node scripts/build-doc-sources.mjs",
    "docs:check": "node scripts/build-doc-sources.mjs --check",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "serve": "node scripts/serve-static.mjs dist 4173",
    "check:a11y": "node scripts/check.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:docs": "node scripts/build-doc-sources.mjs --check",
    "assets": "node scripts/og.mjs && node scripts/icons.mjs"
  },
  "dependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.14.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
